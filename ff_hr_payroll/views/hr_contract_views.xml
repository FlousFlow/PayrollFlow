<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.tree</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="wage"/>
                <field name="schedule_pay"/>
                <field name="struct_id" optional="show"/>
                <field name="structure_type_id"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="state" decoration-success="state == 'open'"
                       decoration-muted="state in ('draft','cancel')"
                       decoration-danger="state == 'close'"/>
            </list>
        </field>
    </record>

    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.form</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_open" type="object" string="Start Contract"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Contract"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('draft','cancel')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            invisible="state not in ('close','cancel')"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_payslips"
                                class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payslips</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="previous_contract_id" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payroll" name="payroll">
                            <group string="Payroll">
                                <group>
                                    <field name="wage"/>
                                    <field name="currency_id" readonly="1"/>
                                    <field name="schedule_pay"/>
                                </group>
                                <group>
                                    <field name="struct_id"/>
                                    <field name="structure_type_id"/>
                                    <field name="resource_calendar_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_contract_view_search" model="ir.ui.view">
        <field name="name">hr.contract.search</field>
        <field name="model">hr.contract</field>
        <field name="arch" type="xml">
            <search string="Contracts">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="struct_id"/>
                <field name="structure_type_id"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'open')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_expired" string="Expired" domain="[('state', '=', 'close')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_schedule" string="Schedule" context="{'group_by': 'schedule_pay'}"/>
                    <filter name="group_structure" string="Structure" context="{'group_by': 'structure_type_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">hr.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_contract_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first contract
            </p>
            <p>
                Define the employee's contract: wage, schedule, salary structure
                and validity dates. Payroll is computed from running contracts.
            </p>
        </field>
    </record>
</odoo>
