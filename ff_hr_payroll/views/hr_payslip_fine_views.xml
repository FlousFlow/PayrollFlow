<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_fine_list" model="ir.ui.view">
        <field name="name">hr.payslip.fine.list</field>
        <field name="model">hr.payslip.fine</field>
        <field name="arch" type="xml">
            <list string="Fines" decoration-danger="state == 'done'">
                <field name="name" readonly="1"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" optional="hide"/>
                <field name="amount" sum="Total"/>
                <field name="reason"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="hr_payslip_fine_form" model="ir.ui.view">
        <field name="name">hr.payslip.fine.form</field>
        <field name="model">hr.payslip.fine</field>
        <field name="arch" type="xml">
            <form string="HR Fine">
                <header>
                    <button name="action_done" string="Confirm" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state not in ('done','cancelled')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"
                            confirm="Cancel this fine?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group string="Payslip Period">
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="hr_payslip_fine_search" model="ir.ui.view">
        <field name="name">hr.payslip.fine.search</field>
        <field name="model">hr.payslip.fine</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <filter name="state_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="state_done" string="Confirmed"
                        domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_payslip_fine" model="ir.actions.act_window">
        <field name="name">Fines</field>
        <field name="res_model">hr.payslip.fine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_payslip_fine_search"/>
        <field name="context">{'search_default_state_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record a fine / penalty against an employee.
            </p>
            <p>
                Fines confirmed here are automatically deducted from the
                employee's payslip for the matching period.
            </p>
        </field>
    </record>
</odoo>
